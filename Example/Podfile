use_frameworks!

platform :ios, '13.0'

target 'MMTToolForHUD_Example' do
  pod 'MMTToolForHUD', :path => '../'

  target 'MMTToolForHUD_Tests' do
    inherit! :search_paths
  end
end

# Xcode 26 removed libarclite; lift all pods to iOS 13 so they keep building.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end

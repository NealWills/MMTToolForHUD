{
  "name": "mmttoolforhud-appium",
  "version": "0.1.0",
  "private": true,
  "description": "Appium (WebDriverIO) end-to-end tests for the MMTToolForHUD example app",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1",
    "npm": ">=10"
  },
  "scripts": {
    "appium": "env -u APPIUM_HOME appium --address 127.0.0.1",
    "doctor": "env -u APPIUM_HOME appium driver doctor xcuitest",
    "test": "env -u APPIUM_HOME wdio run wdio.conf.js",
    "test:watch": "env -u APPIUM_HOME wdio run wdio.conf.js --watch"
  },
  "devDependencies": {
    "@wdio/appium-service": "^10.2.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "appium": "^4.0.1",
    "appium-xcuitest-driver": "^13.8.0"
  }
}
